{
  "name": "bolna-eval",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright eval harness for the bolna-processing dashboard — behaviour, roles, and visual/CSS assertions with screenshot capture.",
  "type": "module",
  "scripts": {
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:seed": "node scripts/db.mjs seed",
    "app:start": "node scripts/app.mjs start",
    "app:stop": "node scripts/app.mjs stop",
    "eval": "playwright test",
    "eval:ui": "playwright test --ui",
    "shots": "playwright test --grep @shot",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "pg": "^8.13.1"
  }
}
