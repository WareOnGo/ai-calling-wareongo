# ----- Supabase Postgres (session pooler connection string) -----
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> "Session pooler"
# It looks like: postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ----- Secrets (generate your own, e.g. `openssl rand -hex 16`) -----
# Password Bolna must include when calling /api/bolna-webhook (as ?token=... or x-webhook-secret header)
BOLNA_WEBHOOK_SECRET=
# Password your scheduler (AWS) must send as `Authorization: Bearer ...` when calling /api/process
PROCESS_SECRET=

# ----- OpenAI (enrichment) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to "false" to import call data without enrichment (enrich later). Default: enabled.
ENABLE_ENRICHMENT=true

# ----- Optional tuning -----
# How many events to process per /api/process run. Keep small if on Vercel Hobby (short function limit).
PROCESS_BATCH_SIZE=5
# Max retry attempts before an event is left as 'failed'
MAX_ATTEMPTS=8
# Set to "true" to also require the request to originate from Bolna's IP
ENFORCE_BOLNA_IP=false
BOLNA_WEBHOOK_IP=13.203.39.153

# ----- Auth (Google OAuth) for the dashboard -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on the OAuth client (per environment):
#   local: http://localhost:3000/api/auth/google/callback
#   prod:  https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Access is NOT configured here any more — it lives in the bolna_app_users table,
# managed from /dashboard/team. Adding a row grants sign-in; unticking Active revokes
# it, with no redeploy.
#
# ADMIN_EMAILS is a BOOTSTRAP ONLY: these emails are admitted as admins *while the
# table has no active admin row*, so the first person can sign in and populate it.
# Once an admin row exists this variable has no effect. Keep one entry here as a
# recovery path for a table with no admins left.
ADMIN_EMAILS=
# ALLOWED_EMAILS is no longer read. Remove it from your environment.
# ALLOWED_EMAILS=
# Secret for signing session cookies (HMAC). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates all existing sessions (everyone re-logs-in).
SESSION_SECRET=
# Options for the editable "Called By" dropdown (comma-separated)
CALLED_BY_OPTIONS=
